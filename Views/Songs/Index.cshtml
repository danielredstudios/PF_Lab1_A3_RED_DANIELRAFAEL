@model MoodPlaylistGenerator.ViewModels.SongListViewModel
@{
    ViewData["Title"] = "My Songs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fas fa-music me-2"></i>My Songs</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Add New Song
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label for="search" class="form-label">Search Songs</label>
                <input type="text" class="form-control" id="search" name="search" value="@Model.SearchTerm" placeholder="Search by title or artist...">
            </div>
            <div class="col-md-4">
                <label for="moodId" class="form-label">Filter by Mood</label>
                <select class="form-select" id="moodId" name="moodId" onchange="this.form.submit()">
                    <option value="">All Moods</option>
                    @foreach (var mood in Model.Moods)
                    {
                        <option value="@mood.Id" selected="@(Model.SelectedMoodId == mood.Id)">@mood.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Songs.Any())
{
    <div class="row">
        @foreach (var song in Model.Songs)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="card-title mb-0">@song.Title</h5>
                                <p class="card-text text-muted">by @song.Artist</p>
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="@Url.Action("Edit", new { id = song.Id })">Edit</a></li>
                                    <li>
                                        <form method="post" action="@Url.Action("Delete", new { id = song.Id })" onsubmit="return confirm('Are you sure?');">
                                            <button type="submit" class="dropdown-item text-danger">Delete</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div>
                            @foreach (var songMood in song.SongMoods)
                            {
                                <span class="badge me-1" style="background-color: @songMood.Mood.Color;">
                                    @songMood.Mood.Name
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5 card">
        <div class="card-body">
            <i class="fas fa-compact-disc fa-3x text-muted mb-3"></i>
            <h4>No Songs Found</h4>
            <p class="text-muted">Try adjusting your filters or add a new song to your library.</p>
        </div>
    </div>
}