@model MoodPlaylistGenerator.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center mb-4">
    <h1 class="display-5">Welcome back, @User.Identity!.Name!</h1>
    <p class="lead text-muted">Here's a snapshot of your music library.</p>
</div>

<div class="row mb-5 text-center">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <i class="fas fa-music fa-3x mb-3 text-primary"></i>
                <h4 class="card-title">@Model.TotalSongs</h4>
                <p class="card-text text-muted">Total Songs</p>
                <a href="@Url.Action("Index", "Songs")" class="btn btn-sm btn-outline-secondary">View Library</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <i class="fas fa-list-alt fa-3x mb-3 text-success"></i>
                <h4 class="card-title">@Model.TotalPlaylists</h4>
                <p class="card-text text-muted">Playlists Created</p>
                <a href="@Url.Action("Index", "Playlists")" class="btn btn-sm btn-outline-secondary">View Playlists</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <i class="fas fa-plus-circle fa-3x mb-3 text-info"></i>
                <h4 class="card-title">Quick Actions</h4>
                <p class="card-text text-muted">Get started quickly</p>
                <a href="@Url.Action("Create", "Songs")" class="btn btn-sm btn-info">Add Song</a>
                <a href="@Url.Action("Generate", "Playlists")" class="btn btn-sm btn-primary">Generate Playlist</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5><i class="fas fa-compact-disc me-2"></i>Recent Songs</h5>
                <a href="@Url.Action("Index", "Songs")" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body">
                @if (Model.RecentSongs.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var song in Model.RecentSongs)
                        {
                            <li class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@song.Title</h6>
                                    <small class="text-muted">@song.CreatedAt.ToString("MMM dd")</small>
                                </div>
                                <p class="mb-1 text-muted">by @song.Artist</p>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-center text-muted mt-3">No songs yet. Add your first song!</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5><i class="fas fa-stream me-2"></i>Recent Playlists</h5>
                <a href="@Url.Action("Index", "Playlists")" class="btn btn-sm btn-outline-success">View All</a>
            </div>
            <div class="card-body">
                @if (Model.RecentPlaylists.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var playlist in Model.RecentPlaylists)
                        {
                            <li class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@playlist.Name</h6>
                                    <small class="text-muted">@playlist.GeneratedAt.ToString("MMM dd")</small>
                                </div>
                                <p class="mb-1 text-muted">
                                    <span class="badge" style="background-color: @playlist.Mood.Color;">@playlist.Mood.Name</span>
                                    @playlist.PlaylistSongs.Count songs
                                </p>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-center text-muted mt-3">No playlists yet. Generate your first one!</p>
                }
            </div>
        </div>
    </div>
</div>